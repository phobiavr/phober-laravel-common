{
    "name": "phobiavr/phober-laravel-common",
    "description": "Shared Laravel package for the phober microservices (models, HTTP clients, middleware, tracing, pagination, etc.)",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.9",
        "open-telemetry/api": "^1.9",
        "open-telemetry/exporter-zipkin": "^1.2",
        "open-telemetry/sdk": "^1.14",
        "php-http/guzzle7-adapter": "^1.1",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.10",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Phobiavr\\PhoberLaravelCommon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "analyze": "@analyse",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
